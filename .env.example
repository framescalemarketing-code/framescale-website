# Copy to .env.local for local development. Names only; values live in Vercel.

# Resend. Required: the contact and booking routes return 500 without it.
RESEND_API_KEY=
# Where notifications go. Falls back to the public site email.
CONTACT_NOTIFICATION_EMAIL=
# Verified sender. Falls back to noreply@<site hostname>.
RESEND_NOREPLY_FROM=

# Cloudflare Turnstile. Set both or neither. Both are required in production
# (VERCEL_ENV=production, set by Vercel, not here).
CLOUDFLARE_SITE_KEY=
CLOUDFLARE_SECRET_KEY=

# GA4 measurement id (G-XXXXXXX). Events are gated on iubenda consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# iubenda. Hardcoded fallbacks exist in src/lib/iubenda.ts.
NEXT_PUBLIC_IUBENDA_POLICY_ID=
NEXT_PUBLIC_IUBENDA_SITE_ID=
NEXT_PUBLIC_IUBENDA_WIDGET_ID=

# Booking (/book). A Google service account with the owner's calendar shared
# to it at "Make changes to events". The private key keeps its \n escapes.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Optional extra busy source: a private iCal URL for a second calendar. Google is still required.
BOOKING_EXTERNAL_CALENDAR_ICS_URL=
