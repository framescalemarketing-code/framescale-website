# Copy to .env.local for local development. Names only; values live in Vercel.

# Resend. Required: the contact and booking routes return 500 without it.
RESEND_API_KEY=
# Where notifications go. Falls back to the public site email.
CONTACT_NOTIFICATION_EMAIL=
# Verified sender. Falls back to noreply@<site hostname>.
RESEND_NOREPLY_FROM=

# Cloudflare Turnstile. Set both or neither. Both are required in production
# (VERCEL_ENV=production, set by Vercel, not here).
CLOUDFLARE_SITE_KEY=
CLOUDFLARE_SECRET_KEY=

# GA4 measurement id (G-XXXXXXX). Events are gated on iubenda consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# iubenda. Hardcoded fallbacks exist in src/lib/iubenda.ts.
NEXT_PUBLIC_IUBENDA_POLICY_ID=
NEXT_PUBLIC_IUBENDA_SITE_ID=
NEXT_PUBLIC_IUBENDA_WIDGET_ID=

# Booking (/book) needs at least one of the two calendar sources below.
#
# Preferred: a Google service account with the owner's calendar shared to it
# at "Make changes to events". The site then reads busy time live and writes
# each booking into the calendar itself. The private key may keep its \n escapes.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Simpler: the calendar's "secret address in iCal format" from Google Calendar
# settings. Read-only, so bookings arrive by email as invites the owner adds.
# With both set, this feed just adds a second calendar's busy time.
BOOKING_EXTERNAL_CALENDAR_ICS_URL=
